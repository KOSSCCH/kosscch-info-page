---
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
const faviconHref = `${basePath}/favicon.png`;
---

<!doctype html>
<html lang="ko">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href={faviconHref} sizes="32x32" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content="국민대, 숭실대, 순천향대가 함께하는 KOSSCCHTHON 2026 연합 경진대회 안내 페이지"
		/>
		<title>KOSSCCHTHON 2026 연합 경진대회</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		word-break: keep-all;
		overflow-wrap: normal;
	}
</style>
