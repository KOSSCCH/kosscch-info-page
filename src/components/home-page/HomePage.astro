---
import AboutSection from "./sections/AboutSection.astro";
import ParticipationGuideSection from "./sections/ParticipationGuideSection.astro";
import CompetitionTitle from "./sections/CompetitionTitle.astro";
import CompetitionInfo from "./sections/CompetitionInfo.astro";
import CompetitionPlan from "./sections/CompetitionPlan.astro";
import CompetitionReward from "./sections/CompetitionReward.astro";
---

<section class="home-page">
  <main class="section-container">
    <CompetitionTitle />
    <AboutSection />
    <CompetitionInfo />
    <CompetitionPlan />
    <CompetitionReward />
    <ParticipationGuideSection />
  </main>

  <a
    class="floating-application-link"
    href="https://forms.gle/LwN3c4tjxFrGto7A6"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="KOSSCCHTHON 참가 신청 구글폼 열기"
  >
    <span style="margin-right: 2px">참가 신청</span>
    <!-- <span class="floating-application-icon" aria-hidden="true">↗</span> -->
  </a>
</section>

<script>
  import "../../scripts/home-page";
</script>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: auto;
    overscroll-behavior: none;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  :global(body) {
    margin: 0;
    background: #020916;
    color: #ffffff;
    font-family:
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      "Apple SD Gothic Neo",
      "Noto Sans KR",
      "Malgun Gothic",
      sans-serif;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  :global(html::-webkit-scrollbar),
  :global(body::-webkit-scrollbar) {
    display: none;
  }

  :global(a) {
    color: inherit;
    text-decoration: none;
  }

  .home-page {
    min-height: 100vh;
    overflow-x: hidden;
    background:
      radial-gradient(circle at 18% 10%, rgba(37, 99, 235, 0.48), transparent 28rem),
      radial-gradient(circle at 88% 28%, rgba(14, 165, 233, 0.26), transparent 24rem),
      linear-gradient(180deg, #061f68 0%, #020916 18%, #020916 100%);
  }

  .section-container {
    width: 100%;
  }

  .floating-application-link {
    position: fixed;
    right: 24px;
    bottom: 24px;
    z-index: 1000;
    min-height: 58px;
    padding: 0 18px 0 22px;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    border: 1px solid rgba(112, 205, 255, 0.72);
    border-radius: 999px;
    background: linear-gradient(135deg, rgba(0, 112, 217, 0.96), rgba(21, 78, 190, 0.96));
    color: #ffffff;
    font-size: 17px;
    font-weight: 900;
    box-shadow:
      0 14px 36px rgba(0, 48, 140, 0.48),
      0 0 0 1px rgba(255, 255, 255, 0.12) inset;
    backdrop-filter: blur(14px);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .floating-application-link:hover {
    transform: translateY(-3px);
    border-color: #9ee8ff;
    box-shadow:
      0 18px 44px rgba(0, 74, 190, 0.56),
      0 0 24px rgba(56, 213, 255, 0.24);
  }

  .floating-application-link:focus-visible {
    outline: 3px solid #38d5ff;
    outline-offset: 4px;
  }

  .floating-application-icon {
    width: 32px;
    aspect-ratio: 1;
    display: inline-grid;
    place-items: center;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.16);
    font-size: 18px;
    line-height: 1;
  }

  @media (max-width: 520px) {
    .floating-application-link {
      right: 14px;
      bottom: max(14px, env(safe-area-inset-bottom));
      min-height: 52px;
      padding: 0 12px 0 17px;
      gap: 9px;
      font-size: 15px;
    }

    .floating-application-icon {
      width: 28px;
      font-size: 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .floating-application-link {
      transition: none;
    }
  }
</style>
