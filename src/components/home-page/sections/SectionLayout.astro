---
interface Props {
  sectionId: string;
  sectionName: string | null;
  sectionClass?: string;
  tagline?: string;
  title?: string;
  showTitle?: boolean;
  titleTag?: string;
}

const {
  sectionId,
  sectionName,
  sectionClass = "",
} = Astro.props;
---


<div class="sticky-stage" data-section={sectionName}>
  <section id={sectionId} class:list={["panel", sectionClass]}>
      <div class="section-content">
        <slot />
      </div>
  </section>
</div>

<style>
  :root {
    --kosscch-bg-color: transparent;
    --kosscch-panel-bg: rgba(3, 12, 31, 0.72);
    --kosscch-panel-border: rgba(116, 166, 255, 0.34);
    --kosscch-blue: #65a8ff;
    --kosscch-cyan: #38d5ff;
    --kosscch-text-muted: rgba(235, 245, 255, 0.76);
  }

  .sticky-stage {
    position: relative;
    min-height: 100svh;
  }

  .panel {
    position: sticky;
    top: 0;

    min-height: 100svh;
    display: flex;
    align-items: center;

    padding: clamp(72px, 9vw, 112px) clamp(18px, 4vw, 64px);
    overflow: hidden;
  }

  .panel::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background-color: var(--kosscch-bg-color);
  }

  section {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .section-content {
    width: min(100%, 1120px);
    margin: 0 auto;
  }



  :global(p) {
    color: var(--kosscch-text-muted);
    line-height: 1.7;
  }

  @media (max-width: 900px), (pointer: coarse) {
    .sticky-stage {
      min-height: auto;
    }

    .panel {
      position: relative;
      min-height: auto;
      padding: 72px 18px;
      overflow: visible;
    }
  }
</style>
