---
import SectionLayout from "./SectionLayout.astro";

const schedule = [
	{
		label: "모집 및 참가 신청 접수",
		date: "2026.09.01 (화) ~ 09.11 (금)",
		datetime: "2026-09-01",
	},
	{
		label: "참가자 발표",
		date: "2026.09.14 (월)",
		datetime: "2026-09-14",
	},
	{
		label: "대회 시작",
		date: "2026.09.19 (토) 13:00 ~",
		datetime: "2026-09-19T13:00",
	},
	{
		label: "최종 발표 및 시상",
		date: "2026.09.20 (일) 12:00 ~",
		datetime: "2026-09-20T12:00",
	},
	{
		label: "폐회식",
		date: "2026.09.20 (일) 15:00 ~",
		datetime: "2026-09-20T15:00",
	},
];
---

<SectionLayout sectionId="schedule" sectionName="schedule" sectionClass="competition-plan">
	<div class="schedule-content">
		<p class="eyebrow">Schedule</p>
		<h2>대회 일정</h2>

		<ol class="timeline">
			{schedule.map((item, index) => (
				<li>
					<span class="number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
					<div class="timeline-copy">
						<h3>{item.label}</h3>
						<time datetime={item.datetime}>{item.date}</time>
					</div>
				</li>
			))}
		</ol>

		<p class="note">※ 세부일정은 참가팀 수 및 현장 상황에 따라 조정될 수 있습니다.</p>
	</div>
</SectionLayout>

<style>
	.schedule-content {
		width: min(100%, 940px);
		margin: 0 auto;
		color: #ffffff;
	}

	.eyebrow,
	h2,
	h3,
	.note {
		margin: 0;
	}

	.eyebrow {
		color: var(--kosscch-blue);
		font-size: 15px;
		font-weight: 900;
		letter-spacing: 0.14em;
		text-align: center;
		text-transform: uppercase;
	}

	h2 {
		margin-top: 12px;
		font-size: clamp(38px, 6vw, 68px);
		font-weight: 900;
		line-height: 1.05;
		text-align: center;
	}

	.timeline {
		margin: 48px 0 0;
		padding: 0;
		display: grid;
		gap: 14px;
		list-style: none;
	}

	.timeline li {
		padding: 22px clamp(20px, 4vw, 34px);
		display: grid;
		grid-template-columns: 78px minmax(0, 1fr);
		gap: 24px;
		align-items: center;
		border: 1px solid rgba(101, 168, 255, 0.28);
		border-radius: 22px;
		background: rgba(3, 12, 31, 0.74);
	}

	.number {
		width: 58px;
		aspect-ratio: 1;
		display: inline-grid;
		place-items: center;
		border-radius: 16px;
		background: linear-gradient(135deg, rgba(0, 112, 217, 0.86), rgba(3, 12, 31, 0.92));
		color: #ffffff;
		font-size: 20px;
		font-weight: 900;
		box-shadow: 0 0 22px rgba(56, 213, 255, 0.32);
	}

	.timeline-copy {
		display: flex;
		gap: 24px;
		align-items: baseline;
		justify-content: space-between;
	}

	h3 {
		color: rgba(255, 255, 255, 0.9);
		font-size: clamp(17px, 2.2vw, 22px);
		font-weight: 800;
		line-height: 1.35;
	}

	time {
		color: #ffffff;
		font-size: clamp(18px, 2.5vw, 26px);
		font-weight: 900;
		line-height: 1.3;
		text-align: right;
	}

	.note {
		margin-top: 28px;
		color: rgba(235, 245, 255, 0.78);
		font-size: 16px;
		font-weight: 600;
		text-align: center;
	}

	@media (max-width: 720px) {
		.timeline {
			margin-top: 34px;
		}

		.timeline li {
			grid-template-columns: 1fr;
			gap: 14px;
			text-align: center;
		}

		.number {
			margin: 0 auto;
		}

		.timeline-copy {
			flex-direction: column;
			gap: 6px;
			align-items: center;
		}

		time {
			text-align: center;
		}
	}
</style>
