---
import SectionLayout from "./SectionLayout.astro";

interface Props {
	tagline?: string;
	sectionId?: string;
	sectionName?: string;
	sectionClass?: string;
}

const {
	tagline = "Competition",
	sectionId = "info",
	sectionName = "info",
	sectionClass = "",
} = Astro.props;

const infoItems = [
	{
		label: "개인 단위 신청",
		value: "팀이 아닌 개인 단위로 참가 신청서를 제출합니다.",
	},
	{
		label: "팀 빌딩",
		value: "신청자의 기술 스택과 개발 수준을 고려해 3개 대학 참가자가 균형 있게 구성됩니다.",
	},
	{
		label: "결과물 제출",
		value: "정해진 기간 내에 개발 결과물을 제출합니다.",
	},
	{
		label: "참가 혜택",
		value: "AI 개발을 위한 KIRO 크레딧을 제공합니다.",
	},
];
---

<SectionLayout
	sectionId={sectionId}
	sectionName={sectionName}
	tagline={tagline}
	showTitle={false}
	sectionClass={`competition-info ${sectionClass}`.trim()}
>
	<div class="competition-content">
		<p class="eyebrow">{tagline}</p>
		<h2 class="section-title">모집 안내</h2>
		<p class="section-lead">신청은 개인 단위로 받고, 현장에서 균형 있는 팀을 구성해 함께 개발합니다.</p>

		<div class="info-panel" role="list">
			{infoItems.map((item, index) => (
				<article class="info-card" role="listitem">
					<span class="step" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
					<div>
						<h3>{item.label}</h3>
						<p>{item.value}</p>
					</div>
				</article>
			))}
		</div>
	</div>

	<slot />
</SectionLayout>

<style>
	.competition-content {
		width: min(100%, 980px);
		margin: 0 auto;
		color: #ffffff;
	}

	.eyebrow,
	.section-lead,
	h3,
	p {
		margin: 0;
	}

	.eyebrow {
		color: var(--kosscch-blue);
		font-size: 15px;
		font-weight: 900;
		letter-spacing: 0.14em;
		text-align: center;
		text-transform: uppercase;
	}

	.section-title {
		margin: 12px 0 0;
		color: #ffffff;
		font-size: clamp(38px, 6vw, 68px);
		font-weight: 900;
		line-height: 1.05;
		text-align: center;
	}

	.section-lead {
		max-width: 720px;
		margin: 18px auto 0;
		color: rgba(235, 245, 255, 0.8);
		font-size: clamp(17px, 2vw, 21px);
		font-weight: 600;
		line-height: 1.65;
		text-align: center;
	}

	.info-panel {
		margin-top: 44px;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 18px;
	}

	.info-card {
		min-height: 190px;
		padding: clamp(22px, 4vw, 32px);
		display: grid;
		grid-template-columns: 78px minmax(0, 1fr);
		gap: 22px;
		align-items: start;
		border: 1px solid rgba(101, 168, 255, 0.28);
		border-radius: 24px;
		background: rgba(3, 12, 31, 0.72);
		box-shadow: 0 22px 64px rgba(0, 0, 0, 0.24);
	}

	.step {
		width: 72px;
		aspect-ratio: 1;
		display: inline-grid;
		place-items: center;
		border: 1px solid rgba(56, 213, 255, 0.76);
		border-radius: 18px;
		background: rgba(0, 79, 159, 0.28);
		box-shadow: 0 0 24px rgba(21, 102, 232, 0.42) inset;
		color: #ffffff;
		font-size: 28px;
		font-weight: 900;
	}

	h3 {
		color: #ffffff;
		font-size: clamp(22px, 3vw, 32px);
		font-weight: 900;
		line-height: 1.2;
	}

	.info-card p {
		margin-top: 10px;
		color: rgba(235, 245, 255, 0.8);
		font-size: clamp(16px, 2vw, 19px);
		font-weight: 600;
		line-height: 1.6;
	}

  @media (max-width: 820px) {
    .info-panel {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .info-card {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .step {
      margin: 0 auto;
    }
  }

	@media (min-width: 901px) and (pointer: fine) and (max-height: 900px) {
		.eyebrow {
			font-size: 14px;
		}

		.section-title {
			margin-top: 8px;
			font-size: clamp(34px, 6.5vh, 54px);
		}

		.section-lead {
			margin-top: 12px;
			font-size: clamp(15px, 2.2vh, 18px);
			line-height: 1.5;
		}

		.info-panel {
			margin-top: 24px;
			gap: 12px;
		}

		.info-card {
			min-height: 142px;
			padding: clamp(18px, 2.8vh, 24px);
			grid-template-columns: 60px minmax(0, 1fr);
			gap: 16px;
			border-radius: 20px;
		}

		.step {
			width: 56px;
			border-radius: 14px;
			font-size: 22px;
		}

		h3 {
			font-size: clamp(20px, 3vh, 26px);
		}

		.info-card p {
			margin-top: 7px;
			font-size: clamp(15px, 2vh, 17px);
			line-height: 1.5;
		}
	}
</style>
