---
import SectionLayout from "./SectionLayout.astro";

const criteria = [
	{
		title: "완성도",
		weight: "50%",
		description: "개발 목표 및 필수 기능의 완성도 높은 구현",
	},
	{
		title: "실용성",
		weight: "30%",
		description: "실생활에서의 도입 가능성 및 안정적인 데모 시연",
	},
	{
		title: "전달성",
		weight: "20%",
		description: "발표 전달력 및 프로젝트의 성장 가능성",
	},
];
---

<SectionLayout sectionId="reward" sectionName="reward" sectionClass="competition-reward">
	<div class="reward-content">
		<p class="eyebrow">Evaluation & Awards</p>
		<h2>심사 기준</h2>

		<div class="criteria-grid">
			{criteria.map((item) => (
				<article class="criteria-card">
					<div class="criteria-head">
						<h3>{item.title}</h3>
						<strong>{item.weight}</strong>
					</div>
					<p>{item.description}</p>
				</article>
			))}
		</div>

		<section class="award-panel" aria-labelledby="award-title">
			<div>
				<p class="award-kicker">시상 내역</p>
				<h3 id="award-title">총 상금 1,500,000원</h3>
			</div>
			<ul>
				<li>대상 3팀, 각 500,000원</li>
				<li>각 대학 SW중심대학 사업단장 명의 상장 수여</li>
			</ul>
		</section>

		<p class="note">※ 심사 및 시상 일정은 진행 상황에 따라 변경될 수 있습니다.</p>
	</div>
</SectionLayout>

<style>
	.reward-content {
		width: min(100%, 980px);
		margin: 0 auto;
		color: #ffffff;
	}

	.eyebrow,
	h2,
	h3,
	p {
		margin: 0;
	}

	.eyebrow {
		color: var(--kosscch-blue);
		font-size: 15px;
		font-weight: 900;
		letter-spacing: 0.14em;
		text-align: center;
		text-transform: uppercase;
	}

	h2 {
		margin-top: 12px;
		font-size: clamp(38px, 6vw, 68px);
		font-weight: 900;
		line-height: 1.05;
		text-align: center;
	}

	.criteria-grid {
		margin-top: 46px;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 16px;
	}

	.criteria-card,
	.award-panel {
		border: 1px solid rgba(101, 168, 255, 0.28);
		border-radius: 24px;
		background: rgba(3, 12, 31, 0.74);
		box-shadow: 0 22px 64px rgba(0, 0, 0, 0.22);
	}

	.criteria-card {
		padding: 26px;
	}

	.criteria-head {
		display: flex;
		gap: 14px;
		align-items: center;
		justify-content: space-between;
	}

	.criteria-head h3 {
		font-size: clamp(22px, 3vw, 32px);
		font-weight: 900;
		line-height: 1.1;
	}

	.criteria-head strong {
		color: var(--kosscch-cyan);
		font-size: clamp(24px, 3vw, 34px);
		font-weight: 900;
	}

	.criteria-card p {
		margin-top: 18px;
		color: rgba(235, 245, 255, 0.78);
		font-size: 17px;
		font-weight: 600;
		line-height: 1.6;
	}

	.award-panel {
		margin-top: 18px;
		padding: clamp(26px, 4vw, 36px);
		display: grid;
		grid-template-columns: minmax(0, 0.95fr) minmax(0, 1fr);
		gap: 24px;
		align-items: center;
	}

	.award-kicker {
		color: var(--kosscch-blue);
		font-size: 16px;
		font-weight: 900;
	}

	.award-panel h3 {
		margin-top: 10px;
		color: #ffffff;
		font-size: clamp(30px, 4vw, 44px);
		font-weight: 900;
		line-height: 1.1;
		word-break: keep-all;
	}

	.award-panel ul {
		margin: 0;
		padding-left: 22px;
		display: grid;
		gap: 12px;
		color: rgba(255, 255, 255, 0.9);
		font-size: clamp(17px, 2vw, 22px);
		font-weight: 800;
		line-height: 1.5;
	}

	.note {
		margin-top: 24px;
		color: rgba(235, 245, 255, 0.78);
		font-size: 16px;
		font-weight: 600;
		text-align: center;
	}

	@media (max-width: 820px) {
		.criteria-grid,
		.award-panel {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 520px) {
		.criteria-head {
			align-items: flex-start;
			flex-direction: column;
		}
	}

	@media (min-width: 901px) and (pointer: fine) and (max-height: 900px) {
		.eyebrow {
			font-size: 14px;
		}

		h2 {
			margin-top: 8px;
			font-size: clamp(34px, 6.5vh, 54px);
		}

		.criteria-grid {
			margin-top: 24px;
			gap: 12px;
		}

		.criteria-card,
		.award-panel {
			border-radius: 20px;
		}

		.criteria-card {
			padding: clamp(18px, 2.8vh, 24px);
		}

		.criteria-head h3 {
			font-size: clamp(20px, 3vh, 26px);
		}

		.criteria-head strong {
			font-size: clamp(22px, 3.3vh, 28px);
		}

		.criteria-card p {
			margin-top: 10px;
			font-size: clamp(15px, 2vh, 16px);
			line-height: 1.5;
		}

		.award-panel {
			margin-top: 12px;
			padding: clamp(18px, 2.8vh, 24px);
		}

		.award-kicker {
			font-size: 14px;
		}

		.award-panel h3 {
			margin-top: 6px;
			font-size: clamp(26px, 4.2vh, 36px);
		}

		.award-panel ul {
			gap: 7px;
			font-size: clamp(16px, 2.3vh, 19px);
		}

		.note {
			margin-top: 14px;
			font-size: 14px;
		}
	}
</style>
